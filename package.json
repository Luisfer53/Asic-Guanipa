{
  "name": "backend-auth-system",
  "version": "1.0.0",
  "description": "Backend de autenticación con Node.js, Express y PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "tunnel": "bash ./start-tunnel.sh",
    "start:all": "bash ./start-all.sh",
    "deploy:apk": "bash ./deploy-apk.sh",
    "deploy:apk:debug": "DEBUG_DEPLOY_APK=true bash -x ./deploy-apk.sh",
    "test": "jest --runInBand",
    "test:host": "DB_HOST=localhost jest --runInBand"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "authentication",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "swagger-express": "^1.0.5",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
