#!/bin/sh
set -e

cd /app/

# Instalar dependencias si no existen
if [ ! -d "./node_modules" ]; then
  echo "Installing dependencies..."
  npm install || { echo "npm install failed!" >&2; exit 2; }
else
  echo "Dependencies already installed."
fi

# Ejecutar migraciones (usando las variables de entorno de Docker Compose)
echo "Running database migrations..."
npx sequelize-cli db:migrate || echo "Migrations failed or already up to date."

# Ejecutar seeds (ignorar error si ya existen)
echo "Running database seeds..."
npx sequelize-cli db:seed:all || echo "Seeds failed or already applied."

# Iniciar el servidor (node puro, sin nodemon para estabilidad en Docker)
echo "Starting server..."
exec node server.js
